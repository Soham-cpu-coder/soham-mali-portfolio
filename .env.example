# Resend API Key for sending contact emails (get your key at https://resend.com)
RESEND_API_KEY=re_your_api_key_here

# Verified sender email configured in Resend (default testing domain: onboarding@resend.dev)
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Optional GitHub Personal Access Token to bypass unauthenticated REST API rate limits
GITHUB_TOKEN=
